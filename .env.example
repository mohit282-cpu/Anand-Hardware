# ==============================================
# ANAND HARDWARE — Environment Configuration
# ==============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.

# SUPABASE PUBLIC CONFIGURATION (Required — used by browser client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SUPABASE SERVER CONFIGURATION (Required — used by server-side Supabase client)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
